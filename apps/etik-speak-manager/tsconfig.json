{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@mfe/shared-http": [
        "src/standalone-http.ts"
      ],
      // #1122: mfe-ethic pulls the platform grid from the design system's
      // advanced subpath, which the package export map does not list. ONLY
      // this subpath is mapped to src — a blanket @mfe/design-system/* map
      // would drag the whole design-system + x-charts source tree into this
      // cell's compilation and surface eight pre-existing type debts that
      // belong to those packages, not to this cell.
      "@mfe/design-system/advanced/data-grid": [
        "../../packages/design-system/src/advanced/data-grid"
      ]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src",
    "../mfe-ethic/src"
  ],
  "exclude": [
    "../mfe-ethic/src/app/services/**"
  ]
}
